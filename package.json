{
  "name": "sispertani-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend SISPERTANI — API JSON dari MySQL + dasbor admin (import/export Excel, bantuan pemerintah)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:patch": "node --env-file=.env scripts/apply_production_patch.js",
    "db:patch-unggulan": "node --env-file=.env scripts/patch_komoditas_unggulan.js",
    "db:import-distankan": "node --env-file=.env scripts/import_unmerged_distankan.js",
    "db:import-fsva": "node --env-file=.env scripts/import_fsva_desa.js",
    "rag:offline": "python scripts/offline_rag.py"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "mysql2": "^3.11.5"
  }
}
